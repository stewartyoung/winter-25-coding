    {
      "id": "DHuV_l6cwzN43Q6taoj_n",
      "type": "text",
      "x": 1437.1296952220948,
      "y": 1616.7300655351892,
      "width": 800.6394653320312,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4J",
      "roundness": null,
      "seed": 1591456875,
      "version": 452,
      "versionNonce": 1820388843,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775489866422,
      "link": null,
      "locked": false,
      "text": "To Handle high requests\nintroduce a queue in front of vehicle search service and pull from the \nqueue when ride matching service is ready to handle\n- partition queue by region\n- prioritise availability of bikes when searching ( few seconds stale is fine)\n- prioritise consistency of booking bikes ( no double bookings)\n    - we don't send any vehicle more than one request at a time (idempotency key)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To Handle high requests\nintroduce a queue in front of vehicle search service and pull from the \nqueue when ride matching service is ready to handle\n- partition queue by region\n- prioritise availability of bikes when searching ( few seconds stale is fine)\n- prioritise consistency of booking bikes ( no double bookings)\n    - we don't send any vehicle more than one request at a time (idempotency key)",
      "autoResize": true,
      "lineHeight": 1.25
    },
